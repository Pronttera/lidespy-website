# --- Contact form: where enquiries are recorded ------------------------------
# The site is a static export, so the form posts straight from the browser to a
# Google Apps Script web app bound to the enquiries spreadsheet. The script and
# its deployment steps live in scripts/apps-script/Code.gs.
#
# Paste the deployment's /exec URL here, then rebuild. NEXT_PUBLIC_ vars are
# inlined into the browser bundle at build time, so this URL is public — the
# script must therefore only ever append rows, never read them back.
#
# Sheet layout — the tab needs this header row, in this order:
#   Timestamp | First name | Last name | Email | Phone | Company | Job title |
#   Country | Interest | Goals | Source
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# --- Canonical URLs ----------------------------------------------------------
# Overrides the production origin used by canonical tags, the sitemap and
# robots.txt. Defaults to https://lidespy.com.
NEXT_PUBLIC_SITE_URL=
